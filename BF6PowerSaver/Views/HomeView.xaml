<UserControl
    x:Class="BF6PowerSaver.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BF6PowerSaver.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Name="BF6PowerSaver"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Row="0"
            FontSize="28"
            Text="Get EA ID" />
        <Label />
        <StackPanel
            Grid.Row="1"
            Margin="0,0,0,10"
            Orientation="Horizontal">
            <Label
                Width="115"
                VerticalAlignment="Center"
                Content="Enter EA username" />
            <TextBox
                Width="240"
                Height="25"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />

            <Button
                Margin="20,0,0,0"
                Padding="5,2"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Command="{Binding LookupUsernameCommand}"
                Content="Search" />
        </StackPanel>
        <StackPanel
            Grid.Row="2"
            Margin="0,0,0,10"
            Orientation="Horizontal">
            <Label
                Width="115"
                VerticalAlignment="Center"
                Content="PersonalID" />
            <Border
                Height="25"
                BorderBrush="Silver"
                BorderThickness="1">
                <TextBlock
                    Width="238"
                    Height="auto"
                    Text="{Binding PersonalId, UpdateSourceTrigger=PropertyChanged}" />
            </Border>
            <Button
                Margin="20,0,0,0"
                Padding="5,2"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Command="{Binding Path=NavigateToRankCheckCommand, UpdateSourceTrigger=PropertyChanged}"
                CommandParameter="{Binding}"
                Content="Go to rankchecker" />
        </StackPanel>
    </Grid>
</UserControl>
