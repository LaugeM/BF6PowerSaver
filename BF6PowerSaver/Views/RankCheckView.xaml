<UserControl
    x:Class="BF6PowerSaver.Views.RankCheckView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BF6PowerSaver.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="235"
    d:DesignWidth="400"
    mc:Ignorable="d">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock
                Margin="0,0,0,0"
                FontSize="28"
                Text="Rank checker" />
        </StackPanel>
        <StackPanel
            Grid.Row="1"
            Margin="0,0,0,10"
            Orientation="Horizontal">
            <Label
                Width="175"
                VerticalAlignment="Center"
                Content="Current rank" />
            <TextBox
                Name="CurrentRankTextBox"
                Width="75"
                Height="25"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="{Binding CurrentRank, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />

            <Button
                Width="110"
                Margin="20,0,0,0"
                Padding="5,2"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Command="{Binding LookupCurrentRankCommand}"
                Content="Get current rank" />
        </StackPanel>
        <StackPanel
            Grid.Row="2"
            Margin="0,0,0,10"
            Orientation="Horizontal">
            <StackPanel>
                <TextBlock Width="175" Text="Shutdown computer at rank:" />
                <Border
                    Margin="0,10,0,0"
                    Background="AliceBlue"
                    BorderBrush="Silver"
                    BorderThickness="1">
                    <TextBlock
                        Width="175"
                        VerticalAlignment="Center"
                        Text="Leave blank to shutdown after 10 minutes of no rank-up"
                        TextWrapping="Wrap" />
                </Border>
            </StackPanel>
            <TextBox
                Name="RankGoalTextBox"
                Width="75"
                Height="25"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Text="{Binding RankGoal, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />

            <ToggleButton
                x:Name="ToggleRankCheckService"
                Width="110"
                Margin="18,0,0,0"
                BorderBrush="ForestGreen"
                BorderThickness="4"
                Command="{Binding StartRankCheckerCommand}"
                IsChecked="{Binding Running}">
                <ToggleButton.Style>
                    <Style TargetType="{x:Type ToggleButton}">
                        <Setter Property="Foreground" Value="ForestGreen" />
                        <Setter Property="BorderBrush" Value="ForestGreen" />
                        <Setter Property="Content" Value="Start rank checker" />
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="Red" />
                                <Setter Property="BorderBrush" Value="Red" />
                                <Setter Property="Content" Value="Stop rank checker" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
        </StackPanel>
        <Button
            Grid.Row="3"
            Margin="0,20,0,0"
            Padding="5,2"
            HorizontalAlignment="Left"
            Command="{Binding NavigateToHomeViewCommand}"
            Content="Go back" />
    </Grid>
</UserControl>
